# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# NOTE: "local-*" was meant for stray local-config files — it silently excluded
# src/lib/local-api (the APK offline adapter) from git, which is why the module
# kept being rebuilt after sandbox incidents. Keep the adapter tracked:
!src/lib/local-api/
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills

# android build toolchain (JDK + SDK — too large for git, rebuilt via docs/capacitor/APK_PIPELINE.md)
android-app/toolchain/

# ── open-source repo hygiene (v1.20) ────────────────────────────────
# user's own SQLite data — each developer generates their own via bun run db:push
db/
prisma/dev.db

# gradle / android build outputs (generated locally by cap sync + gradle)
android-app/android/.gradle/
android-app/android/app/build/
android-app/android/build/
android-app/android/local.properties
android-app/android/app/src/main/assets/public/
android-app/android/capacitor-cordova-android-plugins/

# i18n pipeline working cache (regenerable; source dictionaries ARE tracked)
scripts/i18n/out/

# sandbox/dev artifacts
agent-ctx/
.zscripts/
shots/
nohup.out
preview-*.html
preview-*.png

# internal dev notes & local-only helpers (not part of the open-source repo)
worklog.md
/upload/
/Caddyfile
tool-results/
/scripts/dev-orphan.sh
/scripts/serve-static-e2e.sh
/scripts/preview-*.ts
/scripts/logo-path.txt
/scripts/logo-traced.svg
/scripts/trace-logo.py
/tests/*.sh
db/*.db

