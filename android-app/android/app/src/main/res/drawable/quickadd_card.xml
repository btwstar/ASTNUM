<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add dialog card: PURE WHITE in light mode, PURE BLACK in dark
     (values-night) — the same surface identity as the home-screen widgets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_stroke" />
</shape>
