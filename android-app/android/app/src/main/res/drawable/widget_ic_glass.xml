    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- rim -->
    <path
        android:pathData="M6.2,3.5 L17.8,3.5"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000" />
    <!-- tapered body with a rounded base -->
    <path
        android:pathData="M7.4,3.5 L8.7,19.2 A1.8,1.8 0,0 0 10.5,21 L13.5,21 A1.8,1.8 0,0 0 15.3,19.2 L16.6,3.5"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000" />
    <!-- waterline -->
    <path
        android:pathData="M8.1,9.8 L15.9,9.8"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000" />
</vector>
