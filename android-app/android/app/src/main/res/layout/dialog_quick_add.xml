<?xml version="1.0" encoding="utf-8"?>
<!-- «إضافة سريعة» DIALOG (v2.3 redesign + v2.4 water mode) — the floating
     quick-capture card that opens over the home screen. A segmented
     habit⇄note⇄water switcher flips the mode right inside the dialog before
     saving; the widget buttons still pre-select the right one via ?type=.
     Water mode hides the text input and shows the one-tap drinks block:
     drink chips (water/juice/other) + preset amount chips + a custom ml
     field. Surfaces stay PURE WHITE / PURE BLACK (values/values-night)
     exactly like the widgets, and every label arrives pre-formatted per
     the app's language (snapshot quickAdd section — no native l10n). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_dialog_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quickadd_card"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp">

    <!-- header: brand glyph + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_pill_soft">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_ic_zap"
                android:contentDescription=""
                android:tint="@color/widget_accent" />
        </LinearLayout>
        <TextView
            android:id="@+id/qa_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="@color/widget_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- the type switcher: habit ⇄ note ⇄ water, selectable BEFORE saving -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:background="@drawable/qa_seg_track"
        android:padding="3dp">
        <LinearLayout
            android:id="@+id/qa_seg_habit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/qa_seg_active">
            <ImageView
                android:id="@+id/qa_seg_habit_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_ic_repeat"
                android:contentDescription=""
                android:tint="@color/widget_accent_lime" />
            <TextView
                android:id="@+id/qa_seg_habit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/qa_seg_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/qa_seg_note_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_ic_note"
                android:contentDescription=""
                android:tint="@color/widget_text_tertiary" />
            <TextView
                android:id="@+id/qa_seg_note_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/qa_seg_water"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/qa_seg_water_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_ic_glass"
                android:contentDescription=""
                android:tint="@color/widget_text_tertiary" />
            <TextView
                android:id="@+id/qa_seg_water_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/qa_dialog_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/quickadd_input"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:inputType="textCapSentences"
        android:maxLines="4"
        android:imeOptions="actionDone"
        android:textColor="@color/widget_text_primary"
        android:textColorHint="@color/widget_text_tertiary"
        android:textSize="15sp"
        android:hint="" />

    <!-- WATER MODE (v2.4) — one-tap drink logging: shown only when the
         water segment is selected (the text input above hides then).
         Every label/caption is a runtime-filled TextView. -->
    <LinearLayout
        android:id="@+id/qa_water_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- drink chips: water | juice | other (single-select) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/qa_drink_water"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive">
                <ImageView
                    android:id="@+id/qa_drink_water_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_ic_glass"
                    android:contentDescription=""
                    android:tint="@color/widget_text_tertiary" />
                <TextView
                    android:id="@+id/qa_drink_water_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text=""
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/qa_drink_juice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive">
                <ImageView
                    android:id="@+id/qa_drink_juice_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_ic_glass"
                    android:contentDescription=""
                    android:tint="@color/widget_text_tertiary" />
                <TextView
                    android:id="@+id/qa_drink_juice_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text=""
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/qa_drink_other"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive">
                <ImageView
                    android:id="@+id/qa_drink_other_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_ic_glass"
                    android:contentDescription=""
                    android:tint="@color/widget_text_tertiary" />
                <TextView
                    android:id="@+id/qa_drink_other_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text=""
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- the amount caption -->
        <TextView
            android:id="@+id/qa_amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <!-- preset amount chips (values arrive via quickAdd.amounts) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qa_amount_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/qa_amount_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/qa_amount_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/qa_amount_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/qa_amount_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/qa_seg_inactive"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- custom amount (ml) — typing here deselects the chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/qa_amount_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/quickadd_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:textColor="@color/widget_text_primary"
                android:textColorHint="@color/widget_text_tertiary"
                android:textSize="15sp"
                android:hint="" />
            <TextView
                android:id="@+id/qa_amount_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/qa_dialog_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/quickadd_btn_save"
        android:gravity="center"
        android:text=""
        android:textColor="@color/widget_btn_text"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/qa_dialog_cancel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
