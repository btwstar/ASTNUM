<?xml version="1.0" encoding="utf-8"?>
<!-- «جلسات التمرين» 2×2 — day-assigned plans, today highlighted, tap starts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_ic_calendar"
            android:contentDescription=""
            android:tint="@color/widget_accent_lime" />
        <TextView
            android:id="@+id/ses_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/ses_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />
    <LinearLayout android:id="@+id/ses_row_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:id="@+id/ses_day_1"
            android:layout_width="44dp" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView android:id="@+id/ses_name_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_primary"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/ses_detail_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_tertiary"
                android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ses_row_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:id="@+id/ses_day_2"
            android:layout_width="44dp" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView android:id="@+id/ses_name_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_primary"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/ses_detail_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_tertiary"
                android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ses_row_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:id="@+id/ses_day_3"
            android:layout_width="44dp" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView android:id="@+id/ses_name_3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_primary"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/ses_detail_3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_tertiary"
                android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ses_row_4"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:id="@+id/ses_day_4"
            android:layout_width="44dp" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView android:id="@+id/ses_name_4"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_primary"
                android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/ses_detail_4"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_tertiary"
                android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
