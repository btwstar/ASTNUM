<?xml version="1.0" encoding="utf-8"?>
<!-- «وجبات اليوم» 4×2 — the four meals: glyph + name + kcal, protein detail
     + share bar under each, day total in the footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_ic_utensils"
            android:contentDescription=""
            android:tint="@color/widget_accent" />
        <TextView
            android:id="@+id/meal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/meal_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text_tertiary"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/meal_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- meal rows -->
    <LinearLayout android:id="@+id/meal_row_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/meal_icon_1"
                android:layout_width="13dp" android:layout_height="13dp"
                android:src="@drawable/widget_ic_sun" android:contentDescription="" />
            <TextView android:id="@+id/meal_name_1"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="7dp"
                android:text="" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/meal_kcal_1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_detail_slot_1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meal_detail_1"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="20dp"
                android:text="" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/meal_bar_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="52dp" android:layout_height="3dp"
                android:layout_marginStart="6dp"
                android:progressDrawable="@drawable/widget_progress"
                android:max="100" android:progress="0" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/meal_row_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/meal_icon_2"
                android:layout_width="13dp" android:layout_height="13dp"
                android:src="@drawable/widget_ic_utensils" android:contentDescription="" />
            <TextView android:id="@+id/meal_name_2"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="7dp"
                android:text="" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/meal_kcal_2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_detail_slot_2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meal_detail_2"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="20dp"
                android:text="" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/meal_bar_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="52dp" android:layout_height="3dp"
                android:layout_marginStart="6dp"
                android:progressDrawable="@drawable/widget_progress"
                android:max="100" android:progress="0" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/meal_row_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/meal_icon_3"
                android:layout_width="13dp" android:layout_height="13dp"
                android:src="@drawable/widget_ic_moon" android:contentDescription="" />
            <TextView android:id="@+id/meal_name_3"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="7dp"
                android:text="" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/meal_kcal_3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_detail_slot_3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meal_detail_3"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="20dp"
                android:text="" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/meal_bar_3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="52dp" android:layout_height="3dp"
                android:layout_marginStart="6dp"
                android:progressDrawable="@drawable/widget_progress"
                android:max="100" android:progress="0" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/meal_row_4"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/meal_icon_4"
                android:layout_width="13dp" android:layout_height="13dp"
                android:src="@drawable/widget_ic_cookie" android:contentDescription="" />
            <TextView android:id="@+id/meal_name_4"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="7dp"
                android:text="" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/meal_kcal_4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_detail_slot_4"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meal_detail_4"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="20dp"
                android:text="" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/meal_bar_4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="52dp" android:layout_height="3dp"
                android:layout_marginStart="6dp"
                android:progressDrawable="@drawable/widget_progress"
                android:max="100" android:progress="0" />
        </LinearLayout>
    </LinearLayout>

    <!-- footer: day total -->
    <LinearLayout android:id="@+id/meal_footer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical">
        <TextView android:id="@+id/meal_total"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/widget_chip"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:text="" android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/meal_total_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/widget_progress"
            android:max="100" android:progress="0" />
    </LinearLayout>
</LinearLayout>
