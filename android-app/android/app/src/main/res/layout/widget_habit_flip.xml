<?xml version="1.0" encoding="utf-8"?>
<!-- «عادة اليوم» 1×1 flip square — one habit at a time; tap flips to the next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:gravity="center_horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="7dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/hflip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/widget_text_tertiary"
        android:textSize="8sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/hflip_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/widget_ic_check"
        android:contentDescription="" />

    <TextView
        android:id="@+id/hflip_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/hflip_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_chip"
        android:paddingStart="6dp" android:paddingEnd="6dp"
        android:paddingTop="1dp" android:paddingBottom="1dp"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/hflip_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/widget_text_tertiary"
            android:textSize="9sp" />
        <ImageView
            android:id="@+id/hflip_flip_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/widget_ic_flip"
            android:contentDescription="" />
    </LinearLayout>
</LinearLayout>
