# ─────────────────────────────────────────────────────────────
# ASTNUM — local environment
# Copy this file to `.env` before the first run:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Local SQLite database file (created by `bun run db:push`).
# Relative paths resolve against prisma/ — this points at <repo>/db/custom.db.
DATABASE_URL="file:../db/custom.db"
